# ==============================================================================
# متغيرات بيئة المساعد الرقمي لمركز التعليم المستمر
# Continuing Education Center Digital Assistant Environment Variables
# ==============================================================================

# 1. إعدادات Supabase للواجهة الأمامية (GitHub Pages / Local Web App)
# متاح علناً للمصادقة والقراءة الآمنة عبر RLS
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# 2. إعدادات Supabase للخلفية (GitHub Actions Secrets فقط - لا تُكشف للواجهة إطلاقاً)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# 3. إعدادات خادم البريد SMTP (GitHub Actions Secrets فقط)
# إذا كنت تستخدم Gmail، احصل على App Password من حساب Google
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="continuing.education@atu.edu.iq"
SMTP_PASS="your-16-character-app-password"
